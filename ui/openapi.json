{
  "openapi": "3.1.0",
  "info": {
    "title": "joinedcontext Portal API",
    "description": "Administrative and platform management REST API for joinedcontext Portal",
    "license": {
      "name": "EUPL-1.2",
      "identifier": "EUPL-1.2"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "`POST /api/v1/auth/logout` — clears the session and tells the SPA where to send the browser.",
        "description": "It answers with JSON rather than a 302 on purpose: the SPA calls this with `fetch`, and a\ncross-origin redirect to Keycloak is unreadable to it. The browser navigation is the caller's.",
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Session cleared; navigate to endSessionUrl",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutTarget"
                }
              }
            }
          },
          "403": {
            "description": "Missing or mismatched CSRF token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "`GET /api/v1/auth/me` — who is signed in.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "The signed-in identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
              }
            }
          },
          "401": {
            "description": "No live session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{project}/{plural}": {
      "get": {
        "tags": [
          "resources"
        ],
        "operationId": "list",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "description": "Project name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "plural",
            "in": "path",
            "description": "Resource kind plural",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "labelSelector",
            "in": "query",
            "description": "Label selector",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fieldSelector",
            "in": "query",
            "description": "Field selector",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "continue",
            "in": "query",
            "description": "Pagination continue token",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "revision",
            "in": "query",
            "description": "Historical revision",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of resources",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceList"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{project}/{plural}/{name}": {
      "get": {
        "tags": [
          "resources"
        ],
        "operationId": "get_resource",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "description": "Project name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "plural",
            "in": "path",
            "description": "Resource kind plural",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "description": "Resource name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resource envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Condition": {
        "type": "object",
        "required": [
          "type",
          "status",
          "reason",
          "lastTransitionTime"
        ],
        "properties": {
          "lastTransitionTime": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "required": [
          "name",
          "version",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Identity": {
        "type": "object",
        "description": "Who is signed in. Returned by `GET /api/v1/auth/me` and used by every protected route.",
        "required": [
          "subject",
          "username"
        ],
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Keycloak realm roles from the ID token's `realm_access.roles` (CC-42). Empty when the\ntoken asserts none. Display and enablement only — the resource API and the forge enforce\nthe same boundaries independently."
          },
          "subject": {
            "type": "string",
            "description": "Keycloak `sub`: stable, opaque, the only durable user key."
          },
          "username": {
            "type": "string"
          }
        }
      },
      "ListMeta": {
        "type": "object",
        "properties": {
          "continue": {
            "type": [
              "string",
              "null"
            ]
          },
          "remainingItemCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      },
      "LogoutTarget": {
        "type": "object",
        "description": "The URL the browser must visit to finish an RP-initiated logout at Keycloak.",
        "required": [
          "endSessionUrl"
        ],
        "properties": {
          "endSessionUrl": {
            "type": "string",
            "description": "Absolute URL: Keycloak's `end_session_endpoint`, or the portal itself when no realm is\nconfigured."
          }
        }
      },
      "ObjectMeta": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "annotations": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "description": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "name": {
            "type": "string"
          },
          "namespace": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "Phase": {
        "type": "string",
        "enum": [
          "Draft",
          "Pending",
          "Deploying",
          "Live",
          "Error"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "description": "RFC 7807 Problem Details representation.",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "instance": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "ResourceEnvelope": {
        "type": "object",
        "required": [
          "apiVersion",
          "kind",
          "metadata"
        ],
        "properties": {
          "apiVersion": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "metadata": {
            "$ref": "#/components/schemas/ObjectMeta"
          },
          "spec": {
            "type": "object"
          },
          "status": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Status",
                "description": "Never read from Git, always computed by the Portal API (MF-04)."
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "ResourceList": {
        "type": "object",
        "required": [
          "apiVersion",
          "kind",
          "metadata",
          "items"
        ],
        "properties": {
          "apiVersion": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResourceEnvelope"
            }
          },
          "kind": {
            "type": "string"
          },
          "metadata": {
            "$ref": "#/components/schemas/ListMeta"
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "phase"
        ],
        "properties": {
          "conditions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Condition"
            }
          },
          "observedRevision": {
            "type": [
              "string",
              "null"
            ]
          },
          "phase": {
            "$ref": "#/components/schemas/Phase"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "System operations"
    },
    {
      "name": "auth",
      "description": "Sign-in, sign-out and the current identity"
    },
    {
      "name": "resources",
      "description": "Resource operations"
    }
  ]
}
