{
  "name": "@joinedcontext/sdk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "exports": {
    ".": "./src/sdk/index.ts",
    "./server": "./src/sdk/server.ts",
    "./testing": "./src/sdk/testing.ts",
    "./style.css": "./src/sdk/style.css",
    "./tokens.json": "./src/sdk/tokens.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.worker.config.ts && vite build --config vite.template.config.ts && vite build --config vite.runtime.config.ts && vite build --config vite.server.config.ts",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.4.0",
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "echarts": "^6.1.0",
    "maplibre-gl": "^6.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
